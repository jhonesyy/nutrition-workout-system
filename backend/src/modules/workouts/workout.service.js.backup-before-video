const recommendWorkouts = async (userId) => {
  // 1. Require completed assessment.
  const assessmentResult = await pool.query(
    `SELECT *
     FROM workout.user_workout_assessments
     WHERE user_id = $1
       AND assessment_status = 'completed'`,
    [userId]
  );

  const assessment = assessmentResult.rows[0];

  if (!assessment) {
    throw new Error(
      'Complete your workout assessment before requesting recommendations.'
    );
  }

  // 2. Profile context.
  const profileResult = await pool.query(
    `SELECT goal_type, goal_category
     FROM user_profiles
     WHERE user_id = $1`,
    [userId]
  );

  const profile = profileResult.rows[0] || {};

  const goalType = normalize(
    assessment.workout_goal ||
    profile.goal_type ||
    'general fitness'
  );

  const goalCategory = normalize(profile.goal_category);

  const isCut = [
    'weight loss',
    'cutting',
    'fat loss',
    'lean'
  ].some((term) => goalType.includes(term) || goalCategory.includes(term));

  const isBulk = [
    'bulking',
    'muscle gain',
    'strength',
    'mass',
    'athletic'
  ].some((term) => goalType.includes(term) || goalCategory.includes(term));

  // 3. Equipment selected in assessment.
  const allowedEquipment = getAllowedEquipment(
    assessment.available_equipment
  );

  if (allowedEquipment.size === 0) {
    throw new Error(
      'Your assessment does not contain recognized available equipment. Update your assessment.'
    );
  }

  // 4. Load exercise catalog.
  const exResult = await pool.query(
    `SELECT
       id,
       name,
       muscle_group,
       equipment,
       difficulty,
       default_sets,
       default_reps,
       rest_seconds,
       form_tips,
       instructions
     FROM exercises
     ORDER BY id ASC`
  );

  // 5. Progression eligibility.
  const progressionData = await getProgressionData(userId);
  const experience = normalize(assessment.training_experience);

  const progression = getProgressionLevel(
    experience,
    progressionData
  );

  // 6. Injury exclusions.
  const injuredParts = Array.isArray(assessment.injured_body_parts)
    ? assessment.injured_body_parts
    : [];

  const excludedMuscles = getInjuryMuscleGroups(injuredParts);

  const hasUnmappedInjury =
    assessment.has_injuries &&
    (
      injuredParts.length === 0 ||
      excludedMuscles.size === 0
    );

  if (hasUnmappedInjury) {
    throw new Error(
      'Your assessment reports an injury, but the affected body parts cannot be safely matched to exercise categories. Update your assessment before generating a workout plan.'
    );
  }

  // 7. Filter catalog entries.
  const eligible = exResult.rows.filter((exercise) => {
    const muscle = normalize(exercise.muscle_group);
    const difficulty = normalize(exercise.difficulty);

    if (!exercise.id || !exercise.name || !muscle) {
      return false;
    }

    if (!equipmentIsAllowed(exercise.equipment, allowedEquipment)) {
      return false;
    }

    if (!progression.allowed.includes(difficulty)) {
      return false;
    }

    if (excludedMuscles.has(muscle)) {
      return false;
    }

    if (hasUnselectedEquipmentRequirement(exercise, allowedEquipment)) {
      return false;
    }

    if (isExplosiveExercise(exercise)) {
      return false;
    }

    return true;
  });

  if (eligible.length === 0) {
    throw new Error(
      'No exercises match your current equipment, difficulty, and injury restrictions. Update your assessment or ask an appropriate fitness professional for guidance.'
    );
  }

  // 8. Build weekly training schedule.
  const workoutDays = Math.min(
    Math.max(Number(assessment.workout_days_per_week) || 3, 2),
    6
  );

  const sessionDuration = Number(
    assessment.session_duration_minutes
  ) || 60;

  const weeklyTemplateKeys = getWeeklyTemplates(workoutDays);

  const usedExerciseIds = new Set();
  const weeklyMuscleCounts = new Map();

  // Supplemental muscle groups improve coverage when eligible.
  const supplementalGroups = {
    fullA: ['calves'],
    fullB: ['lower back'],
    fullC: ['chest'],
    upperA: [],
    lowerA: ['calves', 'lower back'],
    upperB: [],
    lowerB: ['calves', 'lower back'],
    push: [],
    pull: ['lower back'],
    legs: ['calves', 'lower back']
  };

  // Score exercises using available data quality and variety.
  // This is deterministic; it does not randomly select exercises.
  const scoreExercise = (exercise, targetGroup, dayIndex) => {
    let score = 0;

    const instructions = String(
      exercise.instructions || exercise.form_tips || ''
    ).trim();

    if (instructions.length >= 80) score += 3;
    else if (instructions.length >= 30) score += 2;
    else if (instructions.length > 0) score += 1;

    if (Number(exercise.default_sets) > 0) score += 1;
    if (exercise.default_reps) score += 1;
    if (Number(exercise.rest_seconds) > 0) score += 1;

    const difficulty = normalize(exercise.difficulty);

    if (difficulty === experience) {
      score += 2;
    }

    if (isBulk && [
      'chest',
      'middle back',
      'lats',
      'quadriceps',
      'hamstrings',
      'glutes',
      'shoulders'
    ].includes(targetGroup)) {
      score += 1;
    }

    if (isCut && [
      'quadriceps',
      'hamstrings',
      'glutes',
      'calves'
    ].includes(targetGroup)) {
      score += 1;
    }

    const previousCount = weeklyMuscleCounts.get(targetGroup) || 0;
    score -= previousCount * 2;

    // Small deterministic rotation avoids always choosing the lowest ID.
    const candidateRotation = Math.abs(
      Number(exercise.id) + dayIndex * 7
    ) % 11;

    score += candidateRotation / 100;

    return score;
  };

  const weeklySchedule = weeklyTemplateKeys.map((templateKey, index) => {
    const template = DAY_TEMPLATES[templateKey];
    const dayExercises = [];

    const targetGroups = [
      ...template.groups,
      ...(supplementalGroups[templateKey] || [])
    ];

    // Add only supplemental groups that have eligible exercises.
    const uniqueTargetGroups = [...new Set(targetGroups)];

    for (const targetGroup of uniqueTargetGroups) {
      const candidates = eligible
        .filter((exercise) => {
          return (
            normalize(exercise.muscle_group) === targetGroup &&
            !usedExerciseIds.has(Number(exercise.id))
          );
        })
        .sort((a, b) => {
          const scoreDifference =
            scoreExercise(b, targetGroup, index) -
            scoreExercise(a, targetGroup, index);

          if (scoreDifference !== 0) {
            return scoreDifference;
          }

          return Number(a.id) - Number(b.id);
        });

      const selected = candidates[0];

      if (!selected) continue;

      usedExerciseIds.add(Number(selected.id));

      weeklyMuscleCounts.set(
        targetGroup,
        (weeklyMuscleCounts.get(targetGroup) || 0) + 1
      );

      const prescription = getPrescription(selected, experience);

      dayExercises.push({
        id: selected.id,
        name: Number(selected.id) === 16
          ? 'Bicycle Crunch'
          : selected.name,
        muscle_group: selected.muscle_group,
        equipment: selected.equipment,
        difficulty: selected.difficulty,
        sets: prescription.sets,
        reps: prescription.reps,
        rest_seconds: prescription.rest_seconds,
        instructions: getExerciseInstructions(selected)
      });
    }

    const warmup = [
      {
        activity: 'Easy marching in place',
        duration_minutes: 2,
        instructions: 'Move at a comfortable pace.'
      },
      {
        activity: 'Arm circles and shoulder mobility',
        duration_minutes: 2,
        instructions: 'Use small, controlled circles.'
      },
      {
        activity: 'Hip hinges and gentle bodyweight squats',
        duration_minutes: 2,
        instructions: 'Move slowly within a comfortable range.'
      },
      {
        activity: 'Easy movement rehearsal',
        duration_minutes: 2,
        instructions: 'Rehearse the movements planned for this session without added load.'
      }
    ];

    const cooldown = [
      {
        activity: 'Slow walking and breathing',
        duration_minutes: 2,
        instructions: 'Gradually reduce your pace and breathe normally.'
      },
      {
        activity: 'Gentle stretching',
        duration_minutes: 3,
        instructions: 'Stretch comfortably. Do not force a range of motion or stretch through pain.'
      }
    ];

    // Estimate exercise time.
    const exerciseCount = dayExercises.length;

    const estimatedExerciseMinutes = dayExercises.reduce(
      (total, exercise) => {
        const repMatch = String(exercise.reps).match(/\d+/);

        const repsPerSet = repMatch
          ? Number(repMatch[0])
          : 10;

        const secondsPerSet = Math.max(
          30,
          repsPerSet * 3
        );

        const workMinutes =
          (exercise.sets * secondsPerSet) / 60;

        const restMinutes =
          (
            Math.max(0, exercise.sets - 1) *
            exercise.rest_seconds
          ) / 60;

        return total + workMinutes + restMinutes;
      },
      0
    );

    const transitionMinutes = Math.max(
      0,
      exerciseCount - 1
    );

    const estimatedDuration = Math.ceil(
      13 +
      estimatedExerciseMinutes +
      transitionMinutes
    );

    return {
      day: index + 1,
      label: template.label,
      focus: template.focus,
      session_duration_minutes: sessionDuration,
      estimated_duration_minutes: Math.min(
        estimatedDuration,
        sessionDuration
      ),
      warmup,
      exercises: dayExercises,
      cooldown,
      exercise_count: exerciseCount,
      note: exerciseCount === 0
        ? 'No matching exercises were found for this day. Review the exercise catalog and equipment assessment.'
        : 'Complete the warm-up first. Perform each exercise with controlled technique and take the prescribed rest between sets.'
    };
  });

  // 9. Ensure every training day has exercises.
  const daysWithoutExercises = weeklySchedule.filter(
    (day) => day.exercises.length === 0
  );

  if (daysWithoutExercises.length > 0) {
    throw new Error(
      `The exercise catalog does not contain enough eligible movements for Workout Day(s) ${daysWithoutExercises.map((day) => day.day).join(', ')}. Review the equipment labels, exercise instructions, and muscle-group data before generating this plan.`
    );
  }

  // 10. Collect assigned exercises.
  const assignedExercises = weeklySchedule.flatMap(
    (day) => day.exercises
  );

  const strengthExercises = assignedExercises.filter((exercise) => {
    return !['abdominals', 'core'].includes(
      normalize(exercise.muscle_group)
    );
  });

  const coreExercises = assignedExercises.filter((exercise) => {
    return ['abdominals', 'core'].includes(
      normalize(exercise.muscle_group)
    );
  });

  // 11. Return complete plan.
  return {
    goal: goalType,

    weekly_focus: isBulk
      ? 'strength + volume'
      : isCut
        ? 'balanced strength training'
        : 'balanced fitness',

    training_frequency: workoutDays,

    session_duration_minutes: sessionDuration,

    assessment: {
      training_experience: assessment.training_experience,
      training_age_months: assessment.training_age_months,
      workout_days_per_week: assessment.workout_days_per_week,
      session_duration_minutes: assessment.session_duration_minutes,
      available_equipment: assessment.available_equipment,
      has_injuries: assessment.has_injuries,
      injured_body_parts: assessment.injured_body_parts,
      activity_level: assessment.activity_level
    },

    progression: {
      current_level: progression.currentLevel,
      allowed_difficulty: progression.allowed,
      next_level: progression.nextLevel,
      unlocked: progression.unlocked,
      training_days_last_28_days: progressionData.trainingDays,
      successful_beginner_logs: progressionData.successfulLogs.beginner,
      successful_intermediate_logs: progressionData.successfulLogs.intermediate,
      successful_advanced_logs: progressionData.successfulLogs.advanced,
      message: progression.message,
      progression_note: 'Progression unlocks are system rules based on recent workout logs, not a medical or scientifically validated readiness assessment.'
    },

    weekly_schedule: weeklySchedule,

    recommendations: [
      {
        focus: 'Strength Training',
        reason: 'Exercises assigned to the planned training days.',
        exercises: strengthExercises
      },
      {
        focus: 'Core Training',
        reason: 'Core exercises assigned to the planned training days.',
        exercises: coreExercises
      }
    ],

    total_unique_exercises: assignedExercises.length,

    safety_notice: assessment.has_injuries
      ? 'Some muscle groups were excluded based on the injury areas selected. The exercise dataset does not contain complete medical contraindication information. These exclusions do not establish that the remaining exercises are medically safe. Seek qualified professional guidance before exercising with an injury.'
      : 'General fitness recommendations only. Warm up before training, use controlled technique, and stop if you experience pain, dizziness, or unusual symptoms.'
  };
};


