};

// ======================
// EXERCISE PRESCRIPTION
// ======================

const getPrescription = (exercise, experience) => {
  const difficulty = normalize(exercise.difficulty);
  const defaultSets = parseFirstNumber(exercise.default_sets, 0);
  const defaultReps = parseRepTarget(exercise.default_reps, '');

  let sets;
  let reps;

  if (defaultSets > 0) {
    sets = Math.min(Math.max(defaultSets, 2), 4);
  } else {
    sets = experience === 'beginner' ? 2 : 3;
  }

  if (defaultReps) {
    reps = defaultReps;
  } else {
    reps = '8-12';
  }

  if (experience === 'beginner') {
    sets = Math.min(sets, 3);
  }

  const defaultRest = Number(exercise.rest_seconds);
  let restSeconds = Number.isFinite(defaultRest) && defaultRest > 0
    ? Math.min(Math.max(defaultRest, 30), 180)
    : 90;

  if (difficulty === 'advanced') {
    restSeconds = Math.max(restSeconds, 90);
  }

  return {
    sets,
    reps,
    rest_seconds: restSeconds
  };
};

const getExerciseInstructions = (exercise) => {
  const instructions = String(
    exercise.instructions || exercise.form_tips || ''
  ).trim();

  return instructions || 'Follow controlled technique and stop if you experience pain.';
};

