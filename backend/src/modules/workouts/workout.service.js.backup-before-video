// ======================
// SHARED HELPERS
// ======================

const normalize = (value) =>
  String(value || '').trim().toLowerCase();

const parseFirstNumber = (value, fallback = 0) => {
  const match = String(value || '').match(/\d+/);
  return match ? Number(match[0]) : fallback;
};

const parseRepTarget = (value, fallback = '8-12') => {
  const text = normalize(value);

  if (!text) return fallback;

  const range = text.match(/(\d+)\s*(?:-|to)\s*(\d+)/i);

  if (range) {
    return `${range[1]}-${range[2]}`;
  }

  const single = text.match(/\d+/);

  if (single) {
    return single[0];
  }

  if (text.includes('second') || text.includes('sec')) {
    return '20-30 seconds';
  }

  if (text.includes('minute') || text.includes('min')) {
    return '30-45 seconds';
  }

  return fallback;
};

const getAllowedEquipment = (assessmentEquipment = []) => {
  const aliases = {
    dumbbell: ['dumbbell', 'dumbbells'],
    dumbbells: ['dumbbell', 'dumbbells'],
    'body only': ['body only', 'bodyweight', 'body weight'],
    bodyweight: ['body only', 'bodyweight', 'body weight']
  };

  const allowed = new Set();

  for (const item of assessmentEquipment) {
    const key = normalize(item);

    if (aliases[key]) {
      aliases[key].forEach((alias) => allowed.add(alias));
    } else if (key) {
      allowed.add(key);
    }
  }

  return allowed;
};

const equipmentIsAllowed = (exerciseEquipment, allowedEquipment) => {
  const equipment = normalize(exerciseEquipment);

  if (!equipment) return false;

  return allowedEquipment.has(equipment);
};

const hasUnselectedEquipmentRequirement = (
  exercise,
  allowedEquipment
) => {
  const instructions = normalize(
    `${exercise.instructions || ''} ${exercise.form_tips || ''}`
  );

  if (!instructions) {
    return true;
  }

  const requirements = [
    {
      pattern: /\b(incline bench|decline bench|flat bench|utility bench|military press bench|bench)\b/,
      allowed: ['bench', 'flat bench', 'incline bench', 'decline bench']
    },
    {
      pattern: /\b(pull[- ]?up bar|chin[- ]?up bar|pullup bar)\b/,
      allowed: ['pull-up bar', 'pull up bar', 'chin-up bar']
    },
    {
      pattern: /\b(parallel bars|dip bars|above the bars|between the bars)\b/,
      allowed: ['parallel bars', 'dip bars']
    },
    {
      pattern: /\b(smith machine|power rack|squat rack|bar in a rack|rack)\b/,
      allowed: ['rack', 'power rack', 'smith machine']
    },
    {
      pattern: /\b(cable machine|cable pulley|cable)\b/,
      allowed: ['cable', 'cable machine']
    },
    {
      pattern: /\b(machine|leg press machine)\b/,
      allowed: ['machine']
    },
    {
      pattern: /\b(stability ball|exercise ball|swiss ball)\b/,
      allowed: ['exercise ball', 'stability ball']
    },
    {
      pattern: /\b(box|sturdy elevated platform|elevated platform)\b/,
      allowed: ['box', 'platform', 'elevated platform']
    },
    {
      pattern: /\b(partner|training partner)\b/,
      allowed: ['partner']
    },
    {
      pattern: /\b(towel)\b/,
      allowed: ['towel']
    },
    {
      pattern: /\b(barbell|olympic bar|ez[- ]curl bar)\b/,
      allowed: ['barbell', 'olympic bar', 'ez curl bar']
    },
    {
      pattern: /\b(kettlebell)\b/,
      allowed: ['kettlebell', 'kettlebells']
    },
    {
      pattern: /\b(medicine ball)\b/,
      allowed: ['medicine ball']
    },
    {
      pattern: /\b(resistance band|exercise band)\b/,
      allowed: ['band', 'resistance band']
    }
  ];

  for (const requirement of requirements) {
    if (!requirement.pattern.test(instructions)) {
      continue;
    }

    const userHasRequiredEquipment = requirement.allowed.some((item) =>
      allowedEquipment.has(item)
    );

    if (!userHasRequiredEquipment) {
      return true;
    }
  }

  return false;
};

const isExplosiveExercise = (exercise) => {
  const name = normalize(exercise.name);
  const instructions = normalize(
    `${exercise.instructions || ''} ${exercise.form_tips || ''}`
  );

  const explosivePattern =
    /\b(jump|jumping|jumped|leap|leaping|hop|hopping|plyometric|explosive)\b/;

  return (
    explosivePattern.test(name) ||
    explosivePattern.test(instructions)
  );
};

const getInjuryMuscleGroups = (injuredParts = []) => {
  const mappings = {
    shoulder: ['shoulders', 'traps', 'chest'],
    shoulders: ['shoulders', 'traps', 'chest'],
    knee: ['quadriceps', 'hamstrings', 'calves', 'adductors'],
    knees: ['quadriceps', 'hamstrings', 'calves', 'adductors'],
    back: ['lats', 'middle back', 'lower back', 'traps'],
    lower_back: ['lower back', 'middle back'],
    'lower back': ['lower back', 'middle back'],
    hip: ['glutes', 'abductors', 'adductors', 'quadriceps', 'hamstrings'],
    hips: ['glutes', 'abductors', 'adductors', 'quadriceps', 'hamstrings'],
    elbow: ['biceps', 'triceps', 'forearms'],
    elbows: ['biceps', 'triceps', 'forearms'],
    wrist: ['forearms'],
    wrists: ['forearms'],
    ankle: ['calves'],
    ankles: ['calves'],
    neck: ['neck', 'traps']
  };

  const excluded = new Set();

  for (const part of injuredParts) {
    const key = normalize(part).replace(/[\s-]+/g, '_');
    const groups = mappings[key] || mappings[normalize(part)];

    if (groups) {
      groups.forEach((group) => excluded.add(group));
    }
  }

  return excluded;
};

// ======================
// PROGRESSION
// ======================

const getProgressionData = async (userId) => {
  const result = await pool.query(
    `SELECT
       wl.exercise_id,
       wl.log_date,
       wl.sets_completed,
       wl.reps_completed,
       e.difficulty,
       e.default_sets,
       e.default_reps
     FROM workout_logs wl
     LEFT JOIN exercises e ON e.id = wl.exercise_id
     WHERE wl.user_id = $1
       AND wl.log_date >= CURRENT_DATE - INTERVAL '28 days'
     ORDER BY wl.log_date DESC`,
    [userId]
  );

  const logs = result.rows;

  const trainingDays = new Set(
    logs.map((log) => {
      const date = log.log_date instanceof Date
        ? log.log_date.toISOString().slice(0, 10)
        : String(log.log_date).slice(0, 10);

      return date;
    })
  ).size;

  const successfulLogs = {
    beginner: 0,
    intermediate: 0,
    advanced: 0
  };

  for (const log of logs) {
    if (!log.exercise_id || !log.difficulty) continue;

    const difficulty = normalize(log.difficulty);

    if (!Object.prototype.hasOwnProperty.call(successfulLogs, difficulty)) {
      continue;
    }

    const completedSets = Number(log.sets_completed);
    const requiredSets = parseFirstNumber(log.default_sets, 3);
    const completedReps = parseFirstNumber(log.reps_completed, 0);
    const requiredReps = parseFirstNumber(log.default_reps, 8);

    if (
      completedSets >= requiredSets &&
      completedReps >= requiredReps
    ) {
      successfulLogs[difficulty] += 1;
    }
  }

  return {
    trainingDays,
    successfulLogs
  };
};

const getProgressionLevel = (experience, progressionData) => {
  const trainingDays = progressionData.trainingDays;
  const successful = progressionData.successfulLogs;

  if (experience === 'advanced') {
    return {
      allowed: ['beginner', 'intermediate', 'advanced'],
      currentLevel: 'advanced',
      nextLevel: null,
      unlocked: true,
      message: 'All exercise difficulty levels are available.'
    };
  }

  if (experience === 'intermediate') {
    const canUnlockAdvanced =
      trainingDays >= 12 &&
      successful.intermediate >= 5;

    return {
      allowed: canUnlockAdvanced
        ? ['beginner', 'intermediate', 'advanced']
        : ['beginner', 'intermediate'],
      currentLevel: canUnlockAdvanced ? 'advanced' : 'intermediate',
      nextLevel: canUnlockAdvanced ? null : 'advanced',
      unlocked: canUnlockAdvanced,
      message: canUnlockAdvanced
        ? 'Advanced exercises unlocked based on recent training performance.'
        : 'Log at least 12 training days and 5 successful intermediate exercise logs to unlock advanced exercises.'
    };
  }

  const canUnlockIntermediate =
    trainingDays >= 8 &&
    successful.beginner >= 3;

  return {
    allowed: canUnlockIntermediate
      ? ['beginner', 'intermediate']
      : ['beginner'],
    currentLevel: canUnlockIntermediate ? 'intermediate' : 'beginner',
    nextLevel: canUnlockIntermediate ? null : 'intermediate',
    unlocked: canUnlockIntermediate,
    message: canUnlockIntermediate
      ? 'Intermediate exercises unlocked based on recent training performance.'
      : 'Log at least 8 training days and 3 successful beginner exercise logs to unlock intermediate exercises.'
  };
};

